<component type="desktop">
  <id>darktable.desktop</id>
  <name>darktable</name>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>GPL-3.0+ and GPL-2.0+ and LGPL-2.0+ and BSD-3-Clause and MIT and CC-BY-SA-1.0 and CC-BY-2.5 and CC-BY-NC-3.0</project_license>
  <_summary>Organize and develop images from digital cameras</_summary>
  <translation type="gettext">dt-lite</translation>
  <description>
    <_p>
      dt-lite manages your digital negatives in a database and lets you
      view them through a lighttable. It also enables you to develop raw
      images and enhance them in a darkroom.
    </_p>
    <_p>
      dt-lite supports most modern cameras' raw formats, and does all
      of its processing at very high precision.
    </_p>
  </description>
  <update_contact>darktable-dev@lists.darktable.org</update_contact>
</component>

